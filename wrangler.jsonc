{
  "$schema": "./backend/node_modules/wrangler/config-schema.json",
  "name": "daypack",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
